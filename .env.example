# Copia este archivo como .env para desarrollo local.
PORT=3000
NODE_ENV=development

# PostgreSQL local o Supabase. En Render se configura como variable de entorno.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webcams
# En producción con Render/Supabase, normalmente debe ser true si la conexión exige SSL.
# El servidor activa SSL automáticamente en producción; puedes forzarlo con PGSSL=true.
PGSSL=false

# Credenciales iniciales del administrador. Se crea automáticamente si no existe.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave-por-una-larga-y-segura

# Secreto de sesión: genera uno largo y aleatorio.
SESSION_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Opcional: URL pública de la web para comprobaciones de origen, por ejemplo https://tu-app.onrender.com
APP_ORIGIN=
